# SmartPoli environment template - copy to .env and fill in. Never commit real values.

# --- core ---
SMARTPOLI_DATABASE_URL=sqlite:///./smartpoli.db      # use your Postgres URL in production
SMARTPOLI_JWT_SECRET=                               # long random string; REQUIRED in production
SMARTPOLI_ALLOWED_ORIGINS=http://localhost:8000
SMARTPOLI_PUBLIC_BASE_URL=http://127.0.0.1:8000
SMARTPOLI_DEFAULT_TZ=Asia/Kolkata                   # patient time zone until a device reports its own
SMARTPOLI_REQUIRE_SECURE_CONFIG=0                   # 1 = refuse to start with an insecure config

# --- reminders (Web Push) : python backend/tools/generate_vapid_keys.py ---
SMARTPOLI_VAPID_PRIVATE_KEY=
SMARTPOLI_VAPID_PUBLIC_KEY=
SMARTPOLI_VAPID_SUBJECT=mailto:you@example.com
SMARTPOLI_CRON_SECRET=                              # secret for the external cron -> POST /internal/reminder-sweep

# --- Android Trusted Web Activity (docs/ANDROID_TWA.md) ---
SMARTPOLI_ANDROID_PACKAGE=app.smartpoli.twa
SMARTPOLI_ANDROID_SHA256=                           # release-signing certificate SHA-256, comma-separated if several

# --- WhatsApp / AI / official-source lookups ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
SMARTPOLI_SKIP_TWILIO_SIGNATURE=0                   # keep 0 outside local testing
GROQ_API_KEY=
SMARTPOLI_AI_GAPS=1                                 # 0 = turn off AI-estimated dose gaps
OPENFDA_API_KEY=                                    # optional; raises the openFDA daily limit

# --- testing only ---
SMARTPOLI_DISABLE_SCHEDULER=0                       # 1 = no background reminder timer

# Google sign-in: the OAuth *web client id* from Google Cloud Console (public; no secret needed). Empty = no Google button.
SMARTPOLI_GOOGLE_CLIENT_ID=
# Google sign-in client SECRET: NOT used by the app today (it only checks Google's signed ID token with the public client id). Leave empty; never commit a real value.
SMARTPOLI_GOOGLE_CLIENT_SECRET=
