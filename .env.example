SMARTPOLI_DATABASE_URL=sqlite:///./smartpoli.db

# Optional — free-text symptom interpretation only (llm_helper.py). The app,
# including the manual prescription path, triage, scheduler and reports,
# runs fully without this (CLAUDE.md section 14: "runs with zero API keys").
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Optional — overrides the OCR plugin's handwriting model (ocr_engine/ocr.py).
# Only read if the optional OCR path is installed (requirements-ocr.txt);
# the app never needs this to boot or run the manual path.
TROCR_MODEL=

# Required for real sessions to be trustworthy (auth.py). A dev default is
# used if this is unset, but that default is NOT safe for anything beyond
# local development/demo — set a real random value before deploying.
SMARTPOLI_JWT_SECRET=change-me-to-a-long-random-value

# CORS — comma-separated list of frontend origins allowed to call the API.
# Do NOT use "*" in production. Defaults to localhost origins if unset.
SMARTPOLI_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Opt-in only — runs seed.py on startup if there's no shell to run it by hand
# (e.g. Render's free plan). seed() is idempotent; safe to leave set to 1.
SMARTPOLI_AUTO_SEED=0

# Optional — the WhatsApp bot (whatsapp_bot.py). Every other SmartPoli
# feature is completely unaffected if these are left blank; the webhook
# just refuses with a 503 instead of the app failing to start. See
# WHATSAPP_SETUP.md for how to get these from a (free) Twilio account.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# The public URL Twilio's servers use to reach THIS server's webhook, and
# that this server puts into the emergency-card / dashboard links it sends
# back over WhatsApp. In local dev this is your ngrok (or similar) tunnel
# URL, e.g. https://abcd1234.ngrok-free.app — 127.0.0.1 is not reachable
# from Twilio's side. In production, this is your real deployed URL.
SMARTPOLI_PUBLIC_BASE_URL=http://127.0.0.1:8000
SMARTPOLI_SKIP_TWILIO_SIGNATURE=0
